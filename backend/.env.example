# Recipient Shield -- backend environment configuration
#
# Copy this file to ".env" (same folder) and fill in real values there.
# ".env" is already listed in .gitignore -- never commit real credentials.
# You must RESTART the backend (Ctrl+C, then re-run uvicorn) after creating
# or editing this file -- it's only read once, at server startup.
#
# Everything below is OPTIONAL. If you leave a section blank, that channel
# still generates the message for real and shows/logs it in the app, it
# just isn't actually delivered ("simulated" mode) -- the app runs fine
# either way. Once you've filled something in and restarted, use the
# "Send test notification" button on the dashboard to confirm it actually
# went through -- it will show SENT or FAILED (with the exact error) for
# each channel immediately, without needing to run a full transfer.

# ---------------------------------------------------------------------------
# Real email delivery (SMTP) -- for sending transaction-status emails
# ---------------------------------------------------------------------------
# Easiest setup: a Gmail account with an "App Password" (NOT your normal
# Gmail password):
#   1. Turn on 2-Step Verification on the Gmail account:
#      https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app) -- it gives you a 16-character code.
#   3. Fill in the values below using that code as SMTP_PASSWORD.
#
# Any other SMTP provider (Outlook, a work email, SendGrid's SMTP relay,
# etc.) works too -- just use that provider's host/port/username/password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sortingscripts@gmail.com
SMTP_PASSWORD=jbrd bfkr qqnf bywp
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=Recipient Shield
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Real SMS delivery (Twilio) -- for sending transaction-status texts
# ---------------------------------------------------------------------------
# Twilio's free trial is enough for demo purposes:
#   1. Sign up at https://www.twilio.com/try-twilio (no cost, gives free
#      trial credit -- during signup it will verify YOUR phone number,
#      which is the number you'll be testing with anyway).
#   2. On the Twilio Console dashboard (https://console.twilio.com), copy
#      your "Account SID" and "Auth Token" into the values below.
#   3. Get a Twilio phone number: Console -> Phone Numbers -> Buy a number
#      (a trial account gets one free) -- put it below as
#      TWILIO_FROM_NUMBER, in E.164 format e.g. +15551234567.
#   4. IMPORTANT trial limitation: a Twilio TRIAL account can only send SMS
#      to phone numbers you've verified in the Console (Phone Numbers ->
#      Verified Caller IDs). If it's your own number from step 1 that's
#      already covered; testing with anyone else's number requires
#      verifying it there first, or upgrading the Twilio account (paid,
#      pay-per-message, no verification needed once upgraded).

TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+12345678901

# ---------------------------------------------------------------------------
# Other settings you already had the option to override
# ---------------------------------------------------------------------------
# JWT_SECRET_KEY=change-me-to-something-random
# DATABASE_URL=sqlite:///./data/recipient_shield.db
